# Copy to .env.local and fill in. Never commit .env.local — it is gitignored,
# and the service-role key below bypasses row-level security entirely.
#
# The same variables must also be set on the deployment target (Railway).
# Every NEXT_PUBLIC_* value is inlined into the client bundle at BUILD time,
# not read at runtime, so setting one after a deploy has no effect until the
# service is rebuilt.

# ── Required ─────────────────────────────────────────────────────────────
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Recommended ──────────────────────────────────────────────────────────
# Absolute origin of this deployment, used to build the password-reset link.
#
# Deliberately NOT prefixed NEXT_PUBLIC_: it is read only in a server action,
# so a public prefix would ship it to the browser for no reason and would
# require a rebuild to change (see the note at the top of this file).
#
# It MUST match an entry in Supabase → Authentication → URL Configuration →
# Redirect URLs, which is the real backstop. Leave this blank and the reset
# link falls back to the project's configured Site URL, which is correct by
# definition — that is safer than guessing, so blank is a fine choice in
# production and only really wanted in local development.
#
# This used to be a PARAMETER passed from the browser
# (`window.location.origin`). A server action is a public HTTP endpoint, so
# the caller chose it, and an attacker could have Supabase email a victim a
# genuine recovery link pointing at their own host. Do not reintroduce it.
SITE_URL=

# Server-side only. Bypasses RLS, so it must never be prefixed
# NEXT_PUBLIC_ and never reach the browser.
# Needed by: /admin/staff invite (creates auth users) and
# scripts/seed-demo-data.mjs.
#
# Note that middleware throws in production when the two NEXT_PUBLIC_
# Supabase values above are missing — it fails closed rather than passing
# every request through unauthenticated. A deploy without them will not
# serve traffic.
SUPABASE_SERVICE_ROLE_KEY=

# ── Optional ─────────────────────────────────────────────────────────────
# IANA timezone the organization operates in. Everything that turns a wall
# clock into an instant reads this: the 07:15 late cutoff, the 09:00 absent
# cutoff, day bucketing, shift start/end, and every rendered date.
# Defaults to Africa/Nairobi. See src/lib/timezone.ts.
NEXT_PUBLIC_ORG_TIME_ZONE=Africa/Nairobi

# PowerSync instance URL. Setting this is what turns offline sync on: the
# provider opens a local SQLite database and connects. Leave it empty and
# the app runs online-only, exactly as it does today.
#
# Prerequisites, in order (context-sessions/08-powersync-offline.md):
#   0. 0008_attendance_insert_integrity.sql MUST be applied and verified on
#      THIS database before you set this variable. Until it is, the staff
#      insert policy does not pin org_id, site_id or source, so a sync upload
#      can claim source 'biometric' and skip the geofence entirely — and
#      turning sync on is what makes that the normal write path.
#      Verify, don't assume: `attendance_events.client_event_id` and
#      `employee_site_id()` must both resolve through PostgREST.
#      (This file used to record "0008 is applied as of 10 Aug". That was true
#      of one project and read as though it were true of every environment.
#      A per-database precondition is not a historical note.)
#   1. supabase/powersync-setup.sql run on a DIRECT Postgres connection,
#      then the separate ALTER ROLE ... LOGIN PASSWORD.
#   2. A PowerSync Cloud instance connected to that database, running
#      service version >= 1.20.1 — earlier builds ignore some sync-rule
#      filters under `config: edition: 3`, which these rules use
#      (GHSA-q6wc-xx4m-92fj).
#   3. "Use Supabase Auth" configured, and powersync/sync-rules.yaml
#      validated and deployed.
# Only then paste the instance URL here.
NEXT_PUBLIC_POWERSYNC_URL=
