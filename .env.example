# Copy to .env.local and fill in. Never commit .env.local — it is gitignored,
# and the service-role key below bypasses row-level security entirely.

# ── Required ─────────────────────────────────────────────────────────────
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. Bypasses RLS, so it must never be prefixed
# NEXT_PUBLIC_ and never reach the browser.
# Needed by: /admin/staff invite (creates auth users) and
# scripts/seed-demo-data.mjs.
SUPABASE_SERVICE_ROLE_KEY=

# ── Optional ─────────────────────────────────────────────────────────────
# IANA timezone the organization operates in. Everything that turns a wall
# clock into an instant reads this: the 07:15 late cutoff, the 09:00 absent
# cutoff, day bucketing, shift start/end, and every rendered date.
# Defaults to Africa/Nairobi. See src/lib/timezone.ts.
NEXT_PUBLIC_ORG_TIME_ZONE=Africa/Nairobi

# PowerSync instance URL. LEAVE UNSET until migrations 0007 AND 0008 have
# both been applied — 0007 alone does not enforce the geofence, and setting
# this makes PowerSync's write path the normal one.
# See context & sessions/08-powersync-offline.md.
NEXT_PUBLIC_POWERSYNC_URL=
